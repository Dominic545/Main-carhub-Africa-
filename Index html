<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070b09">
<meta name="description" content="CarHub Africa — Buy. Sell. Drive.">
<title>CarHub Africa — Buy. Sell. Drive.</title>

<style>
:root{
  --bg:#050806;
  --bg2:#09110d;
  --panel:rgba(18,28,23,.68);
  --panel2:rgba(255,255,255,.055);
  --mint:#a8efd1;
  --mint2:#78dab7;
  --text:#f4f7f5;
  --muted:#9ca9a3;
  --line:rgba(255,255,255,.10);
  --gold:#d8c8a7;
  --danger:#ff7e7e;
  --shadow:0 25px 70px rgba(0,0,0,.42);
  --radius:26px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 10% 0%,rgba(120,218,183,.10),transparent 28%),
    radial-gradient(circle at 90% 20%,rgba(168,239,209,.07),transparent 25%),
    linear-gradient(145deg,var(--bg),var(--bg2) 55%,#040605);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
}

body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);
  background-size:60px 60px;
  mask-image:linear-gradient(to bottom,black,transparent 85%);
  z-index:-1;
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(1200px,calc(100% - 32px));
  margin:auto;
}

/* ================= HEADER ================= */

header{
  position:sticky;
  top:14px;
  z-index:100;
  padding-top:14px;
}

.nav{
  min-height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:12px 18px 12px 22px;
  background:rgba(8,13,10,.72);
  backdrop-filter:blur(24px) saturate(150%);
  -webkit-backdrop-filter:blur(24px) saturate(150%);
  border:1px solid var(--line);
  border-radius:24px;
  box-shadow:var(--shadow);
}

.brand{
  font-size:22px;
  font-weight:850;
  letter-spacing:-1px;
  white-space:nowrap;
}

.brand span{
  color:var(--mint);
}

.navlinks{
  display:flex;
  align-items:center;
  gap:8px;
}

.navlinks a{
  padding:11px 15px;
  border-radius:14px;
  color:#b7c1bc;
  font-size:14px;
  transition:.25s;
}

.navlinks a:hover{
  background:rgba(255,255,255,.06);
  color:white;
}

.sell-btn{
  border:0;
  color:#06100b;
  background:linear-gradient(135deg,var(--mint),var(--mint2));
  font-weight:800;
  padding:13px 18px;
  border-radius:15px;
  box-shadow:0 10px 30px rgba(120,218,183,.15);
}

.menu-btn{
  display:none;
  width:43px;
  height:43px;
  border:1px solid var(--line);
  background:var(--panel2);
  color:white;
  border-radius:14px;
}

/* ================= HERO ================= */

.hero{
  padding:76px 0 34px;
  position:relative;
}

.hero-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:center;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  border:1px solid rgba(168,239,209,.18);
  background:rgba(168,239,209,.055);
  color:var(--mint);
  padding:8px 12px;
  border-radius:100px;
  font-size:12px;
  font-weight:750;
  margin-bottom:18px;
}

.eyebrow i{
  width:7px;
  height:7px;
  background:var(--mint);
  border-radius:50%;
  box-shadow:0 0 14px var(--mint);
}

.hero h1{
  font-size:clamp(50px,7vw,88px);
  line-height:.91;
  letter-spacing:-5px;
  max-width:650px;
}

.hero h1 span{
  color:var(--mint);
}

.hero p{
  color:var(--muted);
  font-size:17px;
  line-height:1.7;
  max-width:570px;
  margin:25px 0;
}

.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.primary{
  border:0;
  background:linear-gradient(135deg,var(--mint),var(--mint2));
  color:#06100b;
  padding:15px 20px;
  border-radius:16px;
  font-weight:850;
}

.secondary{
  border:1px solid var(--line);
  background:rgba(255,255,255,.045);
  color:white;
  padding:15px 20px;
  border-radius:16px;
  font-weight:750;
  backdrop-filter:blur(14px);
}

.hero-showcase{
  position:relative;
  min-height:410px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.glow{
  position:absolute;
  width:300px;
  height:300px;
  border-radius:50%;
  background:rgba(120,218,183,.14);
  filter:blur(70px);
}

.showcase-card{
  position:relative;
  width:min(520px,100%);
  min-height:350px;
  border:1px solid var(--line);
  border-radius:34px;
  overflow:hidden;
  background:rgba(255,255,255,.035);
  box-shadow:var(--shadow);
  transform:rotate(2deg);
  transition:.5s;
}

.showcase-card:hover{
  transform:rotate(0) translateY(-8px);
}

.showcase-card img{
  width:100%;
  height:350px;
  object-fit:cover;
  display:block;
  filter:saturate(.95) contrast(1.04);
}

.showcase-overlay{
  position:absolute;
  inset:auto 0 0;
  padding:28px;
  background:linear-gradient(transparent,rgba(0,0,0,.92));
}

.showcase-overlay small{
  color:#b7c1bc;
}

.showcase-overlay h3{
  margin-top:4px;
  font-size:25px;
}

/* ================= SEARCH ================= */

.search-wrap{
  margin:20px auto 52px;
}

.search-box{
  display:grid;
  grid-template-columns:1.5fr 1fr 1fr auto;
  gap:10px;
  padding:10px;
  background:rgba(255,255,255,.045);
  border:1px solid var(--line);
  border-radius:23px;
  backdrop-filter:blur(25px);
  box-shadow:var(--shadow);
}

.search-field{
  min-height:54px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 16px;
  background:rgba(0,0,0,.18);
  border:1px solid rgba(255,255,255,.055);
  border-radius:16px;
}

.search-field span{
  color:var(--muted);
  font-size:18px;
}

.search-field input,
.search-field select{
  width:100%;
  border:0;
  outline:0;
  background:transparent;
  color:white;
}

.search-field input::placeholder{
  color:#78827d;
}

.search-field select option{
  background:#0b110e;
}

.search-box button{
  border:0;
  border-radius:16px;
  padding:0 24px;
  background:var(--mint);
  color:#06100b;
  font-weight:850;
}

/* ================= SECTION ================= */

.section{
  padding:28px 0 70px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  margin-bottom:20px;
}

.section-head h2{
  font-size:36px;
  letter-spacing:-2px;
}

.section-head p{
  color:var(--muted);
  margin-top:5px;
}

.count{
  color:var(--mint);
  font-size:13px;
  font-weight:750;
}

/* ================= CATALOGUE ================= */

.catalogue{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.car-card{
  position:relative;
  overflow:hidden;
  background:linear-gradient(145deg,rgba(255,255,255,.075),rgba(255,255,255,.025));
  border:1px solid var(--line);
  border-radius:27px;
  box-shadow:0 18px 55px rgba(0,0,0,.25);
  transition:transform .45s cubic-bezier(.2,.8,.2,1),border-color .3s,box-shadow .3s;
  will-change:transform;
}

.car-card:hover{
  transform:translateY(-8px);
  border-color:rgba(168,239,209,.22);
  box-shadow:0 28px 70px rgba(0,0,0,.42);
}

.car-image{
  height:285px;
  position:relative;
  overflow:hidden;
  background:#101512;
}

.car-image img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  transition:transform .8s cubic-bezier(.2,.7,.2,1);
}

.car-card:hover .car-image img{
  transform:scale(1.045);
}

.badge{
  position:absolute;
  top:15px;
  left:15px;
  padding:8px 11px;
  border-radius:100px;
  background:rgba(5,8,6,.72);
  border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(14px);
  font-size:11px;
  font-weight:800;
}

.heart{
  position:absolute;
  right:15px;
  top:15px;
  width:40px;
  height:40px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.13);
  background:rgba(5,8,6,.68);
  color:white;
  backdrop-filter:blur(14px);
  font-size:18px;
}

.heart.active{
  color:#ff8f8f;
}

.car-info{
  padding:20px;
}

.car-top{
  display:flex;
  justify-content:space-between;
  gap:15px;
}

.car-title{
  font-size:22px;
  font-weight:800;
  letter-spacing:-.8px;
}

.car-location{
  color:var(--muted);
  font-size:13px;
  margin-top:5px;
}

.price{
  color:var(--mint);
  font-size:19px;
  font-weight:850;
  white-space:nowrap;
}

.specs{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:16px 0;
}

.spec{
  color:#b7c1bc;
  font-size:12px;
  padding:7px 9px;
  background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.065);
  border-radius:10px;
}

.card-bottom{
  display:flex;
  gap:9px;
}

.view-btn,
.chat-btn{
  flex:1;
  padding:12px;
  border-radius:13px;
  font-weight:800;
}

.view-btn{
  background:var(--mint);
  border:0;
  color:#06100b;
}

.chat-btn{
  background:rgba(255,255,255,.045);
  color:white;
  border:1px solid var(--line);
}

/* ================= EMPTY ================= */

.empty{
  display:none;
  padding:60px 20px;
  text-align:center;
  border:1px dashed var(--line);
  border-radius:24px;
  color:var(--muted);
}

.empty strong{
  color:white;
  display:block;
  font-size:20px;
  margin-bottom:7px;
}

/* ================= FEATURES ================= */

.features{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.feature{
  padding:24px;
  min-height:190px;
  border-radius:23px;
  background:rgba(255,255,255,.035);
  border:1px solid var(--line);
  transition:.3s;
}

.feature:hover{
  transform:translateY(-5px);
  background:rgba(255,255,255,.055);
}

.feature-icon{
  width:45px;
  height:45px;
  display:grid;
  place-items:center;
  border-radius:14px;
  background:rgba(168,239,209,.08);
  border:1px solid rgba(168,239,209,.13);
  color:var(--mint);
  font-size:20px;
  margin-bottom:25px;
}

.feature h3{
  margin-bottom:8px;
}

.feature p{
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}

/* ================= HOW IT WORKS ================= */

.steps{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.step{
  position:relative;
  padding:25px;
  border:1px solid var(--line);
  border-radius:24px;
  background:rgba(255,255,255,.03);
}

.step-number{
  color:var(--mint);
  font-size:13px;
  font-weight:850;
  margin-bottom:30px;
}

.step h3{
  margin-bottom:8px;
}

.step p{
  color:var(--muted);
  font-size:13px;
  line-height:1.65;
}

/* ================= FOOTER ================= */

footer{
  border-top:1px solid var(--line);
  padding:45px 0;
  margin-top:20px;
}

.footer-grid{
  display:flex;
  justify-content:space-between;
  gap:30px;
}

.footer-copy{
  color:var(--muted);
  font-size:13px;
  max-width:420px;
  line-height:1.7;
  margin-top:10px;
}

.footer-links{
  display:flex;
  gap:18px;
  color:#aab4af;
  font-size:13px;
}

/* ================= FLOATING BUBBLE ================= */

.bubble{
  position:fixed;
  right:22px;
  bottom:22px;
  z-index:150;
}

.bubble-main{
  width:58px;
  height:58px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(168,239,209,.12);
  color:var(--mint);
  backdrop-filter:blur(20px);
  box-shadow:0 15px 45px rgba(0,0,0,.4);
  font-size:21px;
  transition:.3s;
}

.bubble-main:hover{
  transform:scale(1.06);
}

.bubble-menu{
  position:absolute;
  right:0;
  bottom:70px;
  width:185px;
  display:none;
  padding:8px;
  background:rgba(10,16,13,.86);
  border:1px solid var(--line);
  border-radius:19px;
  backdrop-filter:blur(24px);
  box-shadow:var(--shadow);
}

.bubble.open .bubble-menu{
  display:block;
  animation:pop .22s ease;
}

@keyframes pop{
  from{opacity:0;transform:translateY(8px) scale(.96)}
  to{opacity:1;transform:none}
}

.bubble-menu button{
  width:100%;
  padding:12px;
  border:0;
  background:transparent;
  color:#dce4df;
  text-align:left;
  border-radius:12px;
}

.bubble-menu button:hover{
  background:rgba(255,255,255,.06);
}

/* ================= MODAL ================= */

.modal{
  position:fixed;
  inset:0;
  z-index:300;
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(0,0,0,.68);
  backdrop-filter:blur(12px);
}

.modal.show{
  display:flex;
}

.modal-box{
  width:min(680px,100%);
  max-height:92vh;
  overflow:auto;
  background:#0a100d;
  border:1px solid var(--line);
  border-radius:28px;
  box-shadow:0 35px 100px rgba(0,0,0,.6);
  animation:modalIn .25s ease;
}

@keyframes modalIn{
  from{opacity:0;transform:translateY(15px) scale(.97)}
  to{opacity:1;transform:none}
}

.modal-head{
  position:sticky;
  top:0;
  z-index:2;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px;
  background:rgba(10,16,13,.92);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line);
}

.close{
  width:38px;
  height:38px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(255,255,255,.05);
  color:white;
  font-size:20px;
}

.modal-body{
  padding:20px;
}

.modal-image{
  width:100%;
  height:290px;
  object-fit:cover;
  border-radius:20px;
  margin-bottom:18px;
}

.detail-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  margin:18px 0;
}

.detail{
  padding:14px;
  border:1px solid var(--line);
  border-radius:14px;
  background:rgba(255,255,255,.03);
}

.detail small{
  display:block;
  color:var(--muted);
  margin-bottom:5px;
}

/* ================= FORMS ================= */

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.form-group{
  margin-bottom:13px;
}

.form-group.full{
  grid-column:1/-1;
}

.form-group label{
  display:block;
  color:#bac4bf;
  font-size:12px;
  font-weight:700;
  margin-bottom:7px;
}

.form-group input,
.form-group select,
.form-group textarea{
  width:100%;
  padding:14px;
  border-radius:14px;
  outline:0;
  border:1px solid var(--line);
  background:rgba(255,255,255,.045);
  color:white;
}

.form-group textarea{
  min-height:110px;
  resize:vertical;
}

.form-group select option{
  background:#0a100d;
}

.form-note{
  color:var(--muted);
  font-size:12px;
  line-height:1.6;
  padding:13px;
  border-radius:14px;
  background:rgba(168,239,209,.045);
  border:1px solid rgba(168,239,209,.09);
  margin-bottom:15px;
}

/* ================= INSPECTION ================= */

.calendar{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:6px;
  margin-top:12px;
}

.calendar div{
  min-height:38px;
  display:grid;
  place-items:center;
  border-radius:10px;
  font-size:12px;
}

.calendar .day{
  color:var(--muted);
}

.calendar .date{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.04);
  cursor:pointer;
}

.calendar .date:hover,
.calendar .date.selected{
  background:var(--mint);
  color:#06100b;
  font-weight:800;
}

.time-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
  margin-top:10px;
}

.time{
  padding:11px 4px;
  border:1px solid var(--line);
  border-radius:11px;
  background:rgba(255,255,255,.04);
  color:#c7d0cc;
  font-size:12px;
}

.time.selected{
  background:var(--mint);
  color:#06100b;
  border-color:var(--mint);
  font-weight:800;
}

/* ================= TOAST ================= */

.toast{
  position:fixed;
  left:50%;
  bottom:24px;
  transform:translate(-50%,20px);
  z-index:500;
  padding:13px 17px;
  background:#111914;
  border:1px solid var(--line);
  border-radius:14px;
  color:white;
  box-shadow:var(--shadow);
  opacity:0;
  pointer-events:none;
  transition:.3s;
  font-size:13px;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

/* ================= MOBILE ================= */

@media(max-width:900px){
  .hero-grid{
    grid-template-columns:1fr;
  }

  .hero-showcase{
    min-height:330px;
  }

  .features{
    grid-template-columns:repeat(2,1fr);
  }

  .search-box{
    grid-template-columns:1fr 1fr;
  }

  .search-box button{
    min-height:54px;
  }
}

@media(max-width:680px){
  .container{
    width:min(100% - 22px,1200px);
  }

  header{
    top:8px;
    padding-top:8px;
  }

  .nav{
    min-height:62px;
    border-radius:20px;
  }

  .brand{
    font-size:19px;
  }

  .navlinks{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  .sell-btn{
    display:none;
  }

  .hero{
    padding-top:55px;
  }

  .hero h1{
    font-size:57px;
    letter-spacing:-3.5px;
  }

  .hero p{
    font-size:15px;
  }

  .hero-showcase{
    min-height:260px;
  }

  .showcase-card{
    min-height:260px;
    border-radius:25px;
  }

  .showcase-card img{
    height:260px;
  }

  .showcase-overlay{
    padding:18px;
  }

  .search-box{
    grid-template-columns:1fr;
    border-radius:19px;
  }

  .catalogue{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:9px;
  }

  .car-image{
    height:150px;
  }

  .car-info{
    padding:12px;
  }

  .car-title{
    font-size:15px;
  }

  .price{
    font-size:13px;
  }

  .car-location{
    font-size:10px;
  }

  .specs{
    gap:4px;
    margin:10px 0;
  }

  .spec{
    font-size:9px;
    padding:5px 6px;
  }

  .view-btn,
  .chat-btn{
    padding:9px 4px;
    font-size:10px;
  }

  .badge{
    top:8px;
    left:8px;
    padding:5px 7px;
    font-size:8px;
  }

  .heart{
    top:7px;
    right:7px;
    width:30px;
    height:30px;
    font-size:14px;
  }

  .section-head{
    align-items:start;
  }

  .section-head h2{
    font-size:29px;
  }

  .features,
  .steps{
    grid-template-columns:1fr;
  }

  .footer-grid{
    flex-direction:column;
  }

  .footer-links{
    flex-wrap:wrap;
  }

