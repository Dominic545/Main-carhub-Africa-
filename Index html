function buildCalendar(){

  const calendar=document.getElementById("calendar");

  calendar.innerHTML=`
    <div class="day">SUN</div>
    <div class="day">MON</div>
    <div class="day">TUE</div>
    <div class="day">WED</div>
    <div class="day">THU</div>
    <div class="day">FRI</div>
    <div class="day">SAT</div>
  `;

  const today=new Date();

  /*
    Shows the next 28 days.
  */

  const startDay=today.getDay();

  for(let i=0;i<startDay;i++){
    const blank=document.createElement("div");
    calendar.appendChild(blank);
  }

  for(let i=0;i<28;i++){

    const d=new Date(today);
    d.setDate(today.getDate()+i);

    const cell=document.createElement("div");
    cell.className="date";
    cell.textContent=d.getDate();

    cell.dataset.date=d.toISOString().split("T")[0];

    cell.onclick=()=>{

      document.querySelectorAll(".calendar .date")
        .forEach(x=>x.classList.remove("selected"));

      cell.classList.add("selected");

      selectedDate=cell.dataset.date;
    };

    calendar.appendChild(cell);
  }
}

function selectTime(button){

  document.querySelectorAll(".time")
    .forEach(x=>x.classList.remove("selected"));

  button.classList.add("selected");

  selectedTime=button.textContent;
}

function confirmInspection(){

  if(!selectedDate){
    showToast("Please choose an inspection date");
    return;
  }

  if(!selectedTime){
    showToast("Please choose an inspection time");
    return;
  }

  showToast(`Inspection requested for ${selectedDate} at ${selectedTime}`);

  /*
    Production version:
    Save appointment to CarHub backend,
    create inspection status and notification/reminder.
  */

  closeModal("inspectionModal");
}

