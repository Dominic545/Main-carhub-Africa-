    year:"2024",
    price:"₦78,500,000",
    location:"Abuja",
    type:"SUV",
    transmission:"Automatic",
    fuel:"Petrol",
    badge:"Popular",
    image:"https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=1200&q=85"
  },

  {
    id:3,
    name:"Mercedes-Benz C300",
    year:"2024",
    price:"₦72,000,000",
    location:"Lagos",
    type:"Sedan",
    transmission:"Automatic",
    fuel:"Petrol",
    badge:"New",
    image:"https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=85"
  },

  {
    id:4,
    name:"BMW X5",
    year:"2023",
    price:"₦96,000,000",
    location:"Port Harcourt",
    type:"SUV",
    transmission:"Automatic",
    fuel:"Petrol",
    badge:"Premium",
    image:"https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1200&q=85"
  },

  {
    id:5,
    name:"Honda CR-V",
    year:"2024",
    price:"₦51,500,000",
    location:"Abuja",
    type:"Crossover",
    transmission:"CVT",
    fuel:"Petrol",
    badge:"Available",
    image:"https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?auto=format&fit=crop&w=1200&q=85"
  },

  {
    id:6,
    name:"Hyundai Tucson",
    year:"2024",
    price:"₦48,000,000",
    location:"Lagos",
    type:"SUV",
    transmission:"Automatic",
    fuel:"Petrol",
    badge:"Available",
    image:"https://images.unsplash.com/photo-1619767886558-efdc259cde1a?auto=format&fit=crop&w=1200&q=85"
  }

];

let filteredCars=[...cars];
let selectedCar=null;
let selectedDate=null;
let selectedTime=null;
let favorites=JSON.parse(localStorage.getItem("carhubFavorites") || "[]");

/* ================= RENDER CARS ================= */

function renderCars(list=filteredCars){

  const catalogue=document.getElementById("catalogue");
  const empty=document.getElementById("empty");
  const count=document.getElementById("carCount");

  catalogue.innerHTML="";

  count.textContent=`${list.length} vehicle${list.length===1?"":"s"}`;

  if(!list.length){
    empty.style.display="block";
    return;
  }

  empty.style.display="none";

  list.forEach(car=>{

    const isFavorite=favorites.includes(car.id);

    const card=document.createElement("article");
    card.className="car-card reveal";

    card.innerHTML=`

      <div class="car-image">

        <img src="${car.image}" alt="${car.name}" loading="lazy">

        <div class="badge">${car.badge}</div>

        <button class="heart ${isFavorite?"active":""}"
          onclick="toggleFavorite(${car.id},this)"
          aria-label="Save vehicle">
          ${isFavorite?"♥":"♡"}
        </button>

      </div>

      <div class="car-info">

        <div class="car-top">

          <div>
            <div class="car-title">${car.name}</div>
            <div class="car-location">⌖ ${car.location}</div>
          </div>

          <div class="price">${car.price}</div>

        </div>

        <div class="specs">
          <span class="spec">${car.year}</span>
          <span class="spec">${car.type}</span>
          <span class="spec">${car.transmission}</span>
          <span class="spec">${car.fuel}</span>
        </div>

        <div class="card-bottom">

          <button class="view-btn" onclick="openVehicle(${car.id})">
            View car
          </button>

          <button class="chat-btn" onclick="openChat(${car.id})">
            Chat
          </button>

        </div>

      </div>
    `;

    catalogue.appendChild(card);
  });

  observeReveals();
}

/* ================= SEARCH ================= */

function filterCars(){

  const search=document.getElementById("searchInput").value.toLowerCase().trim();
  const location=document.getElementById("locationFilter").value;
  const type=document.getElementById("typeFilter").value;

  filteredCars=cars.filter(car=>{

    const searchable=[
      car.name,
      car.year,
      car.location,
      car.type,
      car.fuel,
      car.transmission
    ].join(" ").toLowerCase();

    return (
      (!search || searchable.includes(search)) &&
      (!location || car.location===location) &&
      (!type || car.type===type)
    );

  });

  renderCars(filteredCars);
}

document.getElementById("searchInput").addEventListener("input",filterCars);
document.getElementById("locationFilter").addEventListener("change",filterCars);
document.getElementById("typeFilter").addEventListener("change",filterCars);

/* ================= VEHICLE ================= */

function openVehicle(id){

  selectedCar=cars.find(c=>c.id===id);

  if(!selectedCar)return;

  document.getElementById("modalTitle").textContent=selectedCar.name;
  document.getElementById("modalVehicleName").textContent=selectedCar.name;
  document.getElementById("modalLocation").textContent="⌖ "+selectedCar.location;
  document.getElementById("modalPrice").textContent=selectedCar.price;
  document.getElementById("modalYear").textContent=selectedCar.year;
  document.getElementById("modalType").textContent=selectedCar.type;
  document.getElementById("modalTransmission").textContent=selectedCar.transmission;
  document.getElementById("modalFuel").textContent=selectedCar.fuel;

  document.getElementById("modalImage").src=selectedCar.image;

  openModal("vehicleModal");
